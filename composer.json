{
    "name": "so-lean/cleanprospecter",
    "description": "CRM application for business prospecting — DDD / Hexagonal Architecture",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Solean\\Prospecting\\": "src/Prospecting"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\Prospecting\\": "tests/Unit/Prospecting"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Michel MAIER",
            "email": "opensource@solean-it.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "bin-dir": "bin"
    }
}
